# ============================================================
# 11. SPATIAL RESIDUAL ANALYSIS (MORAN'S I)
# ============================================================

print("\n" + "="*70)
print("STEP 10: SPATIAL RESIDUAL ANALYSIS")
print("="*70)

# Compute residuals
residual_records = []

for fold_id, (train_ids, test_ids) in enumerate(folds, start=1):
    for month in range(4, 13):
        train = df_model[(df_model["Common_ID"].isin(train_ids)) & 
                         (df_model["date"] < f"2019-{month:02d}-01")]
        test = df_model[(df_model["Common_ID"].isin(test_ids)) & 
                        (df_model["date"].dt.month == month)]
        
        if train.empty or test.empty:
            continue
        
        model = RandomForestRegressor(**rf_params)
        model.fit(train[features], train[target])
        preds_log = model.predict(test[features])
        
        residuals = np.expm1(test[target].values) - np.expm1(preds_log)
        
        for i, idx in enumerate(test.index):
            residual_records.append({
                "Common_ID": test.loc[idx, "Common_ID"],
                "latitude": test.loc[idx, "latitude"],
                "longitude": test.loc[idx, "longitude"],
                "month": month,
                "residual": residuals[i]
            })

residual_df = pd.DataFrame(residual_records)

# Aggregate residuals
spatial_units = df_model.drop_duplicates("Common_ID")[["Common_ID", "longitude", "latitude"]]
residual_agg = residual_df.groupby("Common_ID")["residual"].mean().reset_index()
residual_agg = residual_agg.merge(spatial_units, on="Common_ID", how="left")

# Calculate Moran's I
coords = residual_agg[["longitude", "latitude"]].values
w = KNN.from_array(coords, k=8)
w.transform = "r"

mi = Moran(residual_agg["residual"].values, w, permutations=999)

print(f"\nResidual records: {len(residual_df)}")
print(f"Spatial units: {len(residual_agg)}")
print(f"\nGLOBAL MORAN'S I")
print("-"*40)
print(f"I  = {mi.I:.4f}")
print(f"p  = {mi.p_sim:.4f}")

if mi.p_sim < 0.05:
    print("✓ Statistically significant spatial autocorrelation detected")
else:
    print("✗ No significant spatial autocorrelation detected")


# ============================================================
