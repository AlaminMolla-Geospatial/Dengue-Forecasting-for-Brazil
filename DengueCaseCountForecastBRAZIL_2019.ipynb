# ============================================================
# 1. IMPORTS AND CONFIGURATION
# ============================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import networkx as nx
import folium
import os
import warnings
from math import radians, sin, cos, sqrt, atan2

from sklearn.ensemble import RandomForestRegressor
from xgboost import XGBRegressor
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
from libpysal.weights import KNN
from esda.moran import Moran

warnings.filterwarnings('ignore')
%matplotlib inline

# Create output directories
os.makedirs("RF_Dengue", exist_ok=True)
os.makedirs("XGB_Dengue", exist_ok=True)
os.makedirs("Baseline_Dengue_NaiveLag1", exist_ok=True)

print("="*70)
print("BRAZIL DENGUE FORECASTING SYSTEM")
print("="*70)
print("Directories created successfully.")


# ============================================================
# 2. DATA LOADING AND EXPLORATION
# ============================================================

print("\n" + "="*70)
print("STEP 1: DATA LOADING")
print("="*70)

# Load main dataset
df = pd.read_csv("BRAZIL_AllVariables_Combined_with_LatLon.csv")
df.columns = df.columns.str.strip()

print(f"✓ Dataset loaded")
print(f"  Shape: {df.shape}")
print(f"  Columns: {len(df.columns)} variables")
print(f"  Sample columns: {df.columns[:5].tolist()}...")

# Load final panel data
df_model = pd.read_csv("brazil_panel_2019_FINAL.csv")
df_model.columns = df_model.columns.str.strip()
df_model["date"] = pd.to_datetime(df_model["date"])
df_model = df_model.sort_values(["Common_ID", "date"])

print(f"✓ Panel data loaded")
print(f"  Shape: {df_model.shape}")
print(f"  Date range: {df_model['date'].min().date()} to {df_model['date'].max().date()}")
print(f"  Unique spatial units: {df_model['Common_ID'].nunique()}")


# ============================================================
# 3. SUMMARY STATISTICS
# ============================================================

print("\n" + "="*70)
print("STEP 2: SUMMARY STATISTICS")
print("="*70)

static_vars = ["near_coast_km", "elevation_meter", "population_density", 
               "builtup_density", "latitude", "longitude"]
monthly_var_bases = ["pdsi", "skin_temperature", "temperature_2m_max", 
                     "temperature_2m_min", "total_precipitation_sum", "vs"]
months = [f"{m:02d}" for m in range(1, 13)]
month_labels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

# Static variables summary
static_rows = []
for v in static_vars:
    s = df[v].dropna()
    for stat, func in [("Mean", np.mean), ("Std", np.std), ("Min", np.min), ("Max", np.max)]:
        static_rows.append({
            "Variable": v, "Type": "Static", "Stat": stat,
            "Overall (Static)": func(s), **{label: np.nan for label in month_labels}
        })

# Monthly variables summary
monthly_rows = []
for base in monthly_var_bases + ["den"]:
    var_type = "Dengue (Monthly)" if base == "den" else "Monthly"
    for stat in ["Mean", "Std", "Min", "Max"]:
        row = {"Variable": base, "Type": var_type, "Stat": stat, "Overall (Static)": np.nan}
        for m, label in zip(months, month_labels):
            col = f"{base}_2019_{m}"
            if col in df.columns:
                s = df[col].dropna()
                val = {"Mean": s.mean(), "Std": s.std(), "Min": s.min(), "Max": s.max()}[stat]
                row[label] = val
            else:
                row[label] = np.nan
        monthly_rows.append(row)

# Combine and save
summary_df = pd.DataFrame(static_rows + monthly_rows)
summary_df = summary_df[["Variable", "Type", "Stat", "Overall (Static)"] + month_labels]
summary_df.to_csv("summary_table.csv", index=False)
print(f"✓ Summary statistics saved to summary_table.csv")
print(f"  Shape: {summary_df.shape}")


# ============================================================
# 4. FEATURE ENGINEERING
# ============================================================

print("\n" + "="*70)
print("STEP 3: FEATURE ENGINEERING")
print("="*70)

# Log transform target and lags
df_model["log_dengue"] = np.log1p(df_model["dengue"])
df_model["log_dengue_lag1"] = np.log1p(df_model["dengue_lag1"])
df_model["log_dengue_lag2"] = np.log1p(df_model["dengue_lag2"])

# Define feature sets
static_features = ["near_coast_km", "elevation_meter", "population_density", 
                   "builtup_fraction", "latitude", "longitude"]

monthly_features = ["pdsi", "skin_temperature", "temperature_2m_max", 
                    "temperature_2m_min", "total_precipitation", "vs"]

lagged_features = [f"{v}_lag{l}" for v in monthly_features for l in [1, 2]]
dengue_lags = ["log_dengue_lag1", "log_dengue_lag2"]

features = static_features + lagged_features + dengue_lags
target = "log_dengue"

print(f"✓ Total features: {len(features)}")
print(f"  - Static variables: {len(static_features)}")
print(f"  - Lagged environmental: {len(lagged_features)}")
print(f"  - Dengue lags: {len(dengue_lags)}")
print(f"  - Feature list: {features[:5]}...")


# ============================================================
# 5. SPATIAL CROSS-VALIDATION FOLDS
# ============================================================

print("\n" + "="*70)
print("STEP 4: SPATIAL CROSS-VALIDATION")
print("="*70)

unique_ids = np.sort(df_model["Common_ID"].unique())
n_folds = 5
fold_size = len(unique_ids) // n_folds

folds = []
for i in range(n_folds):
    start = i * fold_size
    end = len(unique_ids) if i == n_folds - 1 else (i + 1) * fold_size
    test_ids = unique_ids[start:end]
    train_ids = np.setdiff1d(unique_ids, test_ids)
    folds.append((train_ids, test_ids))
    print(f"Fold {i+1}: Train n={len(train_ids)}, Test n={len(test_ids)}")


# ============================================================
# 6. RANDOM FOREST MODEL
# ============================================================

print("\n" + "="*70)
print("STEP 5: RANDOM FOREST MODEL")
print("="*70)

rf_params = {"n_estimators": 1000, "max_features": "sqrt", "n_jobs": -1, "random_state": 42}
results_rf = []
fi_records_rf = []

for fold_id, (train_ids, test_ids) in enumerate(folds, start=1):
    print(f"\n  FOLD {fold_id}")
    
    for month in range(4, 13):
        month_name = pd.to_datetime(f"2019-{month:02d}-01").strftime("%B")
        
        train = df_model[(df_model["Common_ID"].isin(train_ids)) & 
                         (df_model["date"] < f"2019-{month:02d}-01")]
        test = df_model[(df_model["Common_ID"].isin(test_ids)) & 
                        (df_model["date"].dt.month == month)]
        
        if train.empty or test.empty:
            continue
        
        model = RandomForestRegressor(**rf_params)
        model.fit(train[features], train[target])
        
        preds_log = model.predict(test[features])
        y_true = np.expm1(test[target].values)
        y_pred = np.expm1(preds_log)
        
        rmse = np.sqrt(mean_squared_error(y_true, y_pred))
        mae = mean_absolute_error(y_true, y_pred)
        r2 = r2_score(y_true, y_pred)
        
        results_rf.append({"fold": fold_id, "month": month_name, "rmse": rmse, "mae": mae, "r2": r2})
        
        for f, imp in zip(features, model.feature_importances_):
            fi_records_rf.append({"fold": fold_id, "month": month_name, "feature": f, "importance": imp})
        
        print(f"    {month_name:9} | RMSE: {rmse:7.2f} | MAE: {mae:5.2f} | R²: {r2:6.4f}")

results_rf_df = pd.DataFrame(results_rf)
fi_rf_df = pd.DataFrame(fi_records_rf)
print(f"\n✓ Random Forest completed: {len(results_rf)} evaluations")


# ============================================================
# 7. XGBOOST MODEL
# ============================================================

print("\n" + "="*70)
print("STEP 6: XGBOOST MODEL")
print("="*70)

xgb_params = {"n_estimators": 1000, "random_state": 42, "n_jobs": -1}
results_xgb = []
fi_records_xgb = []

for fold_id, (train_ids, test_ids) in enumerate(folds, start=1):
    print(f"\n  FOLD {fold_id}")
    
    for month in range(4, 13):
        month_name = pd.to_datetime(f"2019-{month:02d}-01").strftime("%B")
        
        train = df_model[(df_model["Common_ID"].isin(train_ids)) & 
                         (df_model["date"] < f"2019-{month:02d}-01")]
        test = df_model[(df_model["Common_ID"].isin(test_ids)) & 
                        (df_model["date"].dt.month == month)]
        
        if train.empty or test.empty:
            continue
        
        model = XGBRegressor(**xgb_params)
        model.fit(train[features], train[target], verbose=False)
        
        preds_log = model.predict(test[features])
        y_true = np.expm1(test[target].values)
        y_pred = np.expm1(preds_log)
        
        rmse = np.sqrt(mean_squared_error(y_true, y_pred))
        mae = mean_absolute_error(y_true, y_pred)
        r2 = r2_score(y_true, y_pred)
        
        results_xgb.append({"fold": fold_id, "month": month_name, "rmse": rmse, "mae": mae, "r2": r2})
        
        for f, imp in zip(features, model.feature_importances_):
            fi_records_xgb.append({"fold": fold_id, "month": month_name, "feature": f, "importance": imp})
        
        print(f"    {month_name:9} | RMSE: {rmse:7.2f} | MAE: {mae:5.2f} | R²: {r2:6.4f}")

results_xgb_df = pd.DataFrame(results_xgb)
print(f"\n✓ XGBoost completed: {len(results_xgb)} evaluations")


# ============================================================
# 8. BASELINE MODEL (NAIVE LAG-1)
# ============================================================

print("\n" + "="*70)
print("STEP 7: BASELINE MODEL (NAIVE LAG-1)")
print("="*70)

results_base = []

for fold_id, (train_ids, test_ids) in enumerate(folds, start=1):
    print(f"\n  FOLD {fold_id}")
    
    for month in range(4, 13):
        month_name = pd.to_datetime(f"2019-{month:02d}-01").strftime("%B")
        
        test = df_model[(df_model["Common_ID"].isin(test_ids)) & 
