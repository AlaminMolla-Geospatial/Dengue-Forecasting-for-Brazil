# ============================================================

print("\n" + "="*70)
print("STEP 11: CORRELATION ANALYSIS")
print("="*70)

df_corr = df_model.copy()
df_corr["log_dengue"] = np.log1p(df_corr["dengue"])

correlations = {}
for feat in features:
    if feat in df_corr.columns:
        correlations[feat] = df_corr[feat].corr(df_corr["log_dengue"])

corr_series = pd.Series(correlations).sort_values(ascending=False)

