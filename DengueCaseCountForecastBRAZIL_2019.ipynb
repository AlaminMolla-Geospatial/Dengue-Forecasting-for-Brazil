# ============================================================
# 13. SPATIAL NETWORK ANALYSIS
# ============================================================

print("\n" + "="*70)
print("STEP 12: SPATIAL NETWORK ANALYSIS")
print("="*70)

# Load hotspot data
hotspot_df = pd.read_csv("brazil_dengue_HotSpot95Confd.csv")
monthly_cols = [f"den_2019_{m:02d}" for m in range(1, 13)]
hotspot_df[monthly_cols] = hotspot_df[monthly_cols].fillna(0)
hotspot_df["den_2019_total"] = hotspot_df[monthly_cols].sum(axis=1)

# Weighted gravitational centroid
weights = hotspot_df["den_2019_total"].values
centroid_lat = np.sum(hotspot_df["latitude"] * weights) / np.sum(weights)
centroid_lon = np.sum(hotspot_df["longitude"] * weights) / np.sum(weights)
print(f"Weighted Centroid: ({centroid_lat:.4f}, {centroid_lon:.4f})")

# Haversine distance
def haversine(lat1, lon1, lat2, lon2):
    R = 6371
    lat1, lon1, lat2, lon2 = map(radians, [lat1, lon1, lat2, lon2])
    dlat = lat2 - lat1
    dlon = lon2 - lon1
    a = sin(dlat/2)**2 + cos(lat1)*cos(lat2)*sin(dlon/2)**2
    return R * 2 * atan2(sqrt(a), sqrt(1-a))

# Build network
G = nx.Graph()
n = len(hotspot_df)

for i in range(n):
    G.add_node(i)

for i in range(n):
    for j in range(i+1, n):
        dist = haversine(hotspot_df.loc[i, "latitude"], hotspot_df.loc[i, "longitude"],
                         hotspot_df.loc[j, "latitude"], hotspot_df.loc[j, "longitude"])
        if dist <= 500:
            G.add_edge(i, j)

print(f"Network nodes: {G.number_of_nodes()}")
print(f"Network edges: {G.number_of_edges()}")


# ============================================================
# 14. INTERACTIVE MAP
# ============================================================

print("\n" + "="*70)
print("STEP 13: GENERATING INTERACTIVE MAP")
print("="*70)

# Create base map
m = folium.Map(location=[hotspot_df["latitude"].mean(), hotspot_df["longitude"].mean()], 
               zoom_start=5, tiles="CartoDB Positron")

# Add network edges
edge_layer = folium.FeatureGroup(name="500km Network")
for edge in G.edges():
    lat1, lon1 = hotspot_df.loc[edge[0], "latitude"], hotspot_df.loc[edge[0], "longitude"]
    lat2, lon2 = hotspot_df.loc[edge[1], "latitude"], hotspot_df.loc[edge[1], "longitude"]
    folium.PolyLine(locations=[(lat1, lon1), (lat2, lon2)], weight=1, color="blue", opacity=0.5).add_to(edge_layer)
edge_layer.add_to(m)

# Add municipality nodes
node_layer = folium.FeatureGroup(name="Municipalities")
max_weight = hotspot_df["den_2019_total"].max()
for _, row in hotspot_df.iterrows():
    radius = 3 + (row["den_2019_total"] / max_weight) * 8
    folium.CircleMarker(location=[row["latitude"], row["longitude"]], radius=radius,
                        fill=False, color="red", weight=2,
                        popup=f"Total 2019 Dengue: {row['den_2019_total']}").add_to(node_layer)
node_layer.add_to(m)

# Add centroid
folium.Marker(location=[centroid_lat, centroid_lon], popup="Weighted Gravitational Centroid",
              icon=folium.Icon(color="green", icon="star")).add_to(m)


folium.LayerControl(collapsed=False).add_to(m)
m.save("brazil_dengue_network_map.html")
print("✓ Interactive map saved to brazil_dengue_network_map.html")


