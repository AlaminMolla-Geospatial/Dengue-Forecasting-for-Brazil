        rmse = np.sqrt(mean_squared_error(y_true, y_pred))
        mae = mean_absolute_error(y_true, y_pred)
        r2 = r2_score(y_true, y_pred)
        
        results_base.append({"fold": fold_id, "month": month_name, "rmse": rmse, "mae": mae, "r2": r2})
        print(f"    {month_name:9} | RMSE: {rmse:7.2f} | MAE: {mae:5.2f} | R²: {r2:6.4f}")

results_base_df = pd.DataFrame(results_base)
print(f"\n✓ Baseline completed: {len(results_base)} evaluations")


# ============================================================
# 9. PERFORMANCE VISUALIZATION
# ============================================================

print("\n" + "="*70)
print("STEP 8: PERFORMANCE VISUALIZATION")
print("="*70)

month_order = ["April", "May", "June", "July", "August", 
               "September", "October", "November", "December"]

def plot_heatmap(df_results, metric, cmap, title, save_path):
    plt.figure(figsize=(12, 6))
    pivot = df_results.pivot_table(index="fold", columns="month", values=metric)
    pivot = pivot.reindex(columns=month_order)
    sns.heatmap(pivot, cmap=cmap, annot=True, fmt=".2f")
    plt.title(title, fontsize=14, fontweight="bold")
    plt.tight_layout()
    plt.savefig(save_path, dpi=150, bbox_inches="tight")
    plt.close()
    print(f"  ✓ Saved: {save_path}")

# Random Forest heatmaps
plot_heatmap(results_rf_df, "rmse", "Reds", "RMSE Heatmap — Random Forest", "RF_Dengue/rmse_heatmap.png")
