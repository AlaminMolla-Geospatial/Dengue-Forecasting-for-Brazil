summary_df = pd.DataFrame(summary_data, columns=["Model"] + metrics)
print("\nOVERALL PERFORMANCE")
print("-"*50)
print(summary_df.round(3))

print("\nMONTHLY PERFORMANCE (Random Forest)")
print("-"*50)
monthly_perf = results_rf_df.groupby("month")[["rmse", "mae", "r2"]].mean().round(3)
print(monthly_perf)

print("\nBEST MODEL BY MONTH (based on R²)")
print("-"*50)
best_by_month = []
for month in month_order:
    rf_r2 = results_rf_df[results_rf_df["month"] == month]["r2"].mean()
    xgb_r2 = results_xgb_df[results_xgb_df["month"] == month]["r2"].mean()
    base_r2 = results_base_df[results_base_df["month"] == month]["r2"].mean()
    
    scores = {"Random Forest": rf_r2, "XGBoost": xgb_r2, "Naive Lag-1": base_r2}
    best = max(scores, key=scores.get)
    best_by_month.append({"Month": month, "Best Model": best, "R²": scores[best]})

best_df = pd.DataFrame(best_by_month)
print(best_df.to_string(index=False))


